#!/usr/bin/env bash
set -euo pipefail
trap 'echo "FAILED at line $LINENO in $(basename "$0")" >&2' ERR

log() { printf '[npm-globals] %s\n' "$*" >&2; }

if [ -r "$HOME/.config/corp-certs.pem" ]; then
  export NODE_EXTRA_CA_CERTS="$HOME/.config/corp-certs.pem"
fi

if ! command -v npm >/dev/null 2>&1; then
  log "npm not on PATH — Node didn't install? skipping"
  exit 0
fi

installed=$(npm ls -g --depth=0 --json 2>/dev/null | jq -r '.dependencies | keys[]?' 2>/dev/null || true)

install_if_missing() {
  local pkg="$1"
  if ! grep -qFx "$pkg" <<<"$installed"; then
    log "installing $pkg"
    npm install -g "$pkg" >/dev/null
  fi
}

{{ range .packages.npm.common -}}
install_if_missing "{{ . }}"
{{ end -}}
{{ range (index .packages.npm .machine) -}}
install_if_missing "{{ . }}"
{{ end -}}

log "done"
