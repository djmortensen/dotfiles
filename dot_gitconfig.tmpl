[user]
    name  = {{ .git.name }}
    email = {{ .git.email }}

[init]
    defaultBranch = main

[pull]
    rebase = false

[push]
    autoSetupRemote = true

[credential "https://github.com"]
    helper =
    helper = !{{ lookPath "gh" }} auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !{{ lookPath "gh" }} auth git-credential
